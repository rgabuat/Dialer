---
title: DIDs Module — Data Model & UI Flow
---
flowchart TD
    subgraph DATA["Data Model"]
        direction TB
        DID["Did\nphone_number (unique)\ndescription\nis_active"]
        IG["InGroup"]
        IVR["IvrMenu"]

        DID -->|"belongsTo (nullable)"| IG
        DID -->|"belongsTo (nullable)"| IVR

        CID["CidNumber\nphone_number (unique)\ntwilio_sid\nfriendly_name\nis_active\nin_rotation"]
    end

    subgraph ROUTING["Inbound Call Routing"]
        direction LR
        MATCH["DID matched\nphone_number = Twilio To"]
        HAS_IVR{"ivr_menu_id set?"}
        HAS_GROUP{"in_group_id set?"}
        SERVE_IVR["serveIvrMenu"]
        ROUTE_GROUP["routeToInGroup"]
        NO_DEST["Hang up\nnot configured"]

        MATCH --> HAS_IVR
        HAS_IVR -- "yes" --> SERVE_IVR
        HAS_IVR -- "no" --> HAS_GROUP
        HAS_GROUP -- "yes" --> ROUTE_GROUP
        HAS_GROUP -- "no" --> NO_DEST
    end

    subgraph CID_ROTATION["Outbound CID Rotation"]
        direction LR
        POOL["CidNumber pool\nis_active=true\nin_rotation=true"]
        ROUNDROBIN["Round-robin index\nRedis: cid_rotation:{id}"]
        FALLBACK["Campaign.caller_id\n(fallback)"]

        POOL --> ROUNDROBIN
        ROUNDROBIN -->|"pool empty"| FALLBACK
    end

    subgraph UI["UI Components"]
        direction TB
        IDX["DidsIndex\n/dids\nsearch, paginate\nshows In-Group / IVR Menu"]
        CREATE["DidCreate\n/did/create"]
        EDIT["DidEdit\n/did/{id}/edit"]
        CIDX["CidNumbersIndex\n/cid-numbers\nImported CID: Active + In Rotation toggles\nTwilio list: Import + Sync Webhook"]
    end
